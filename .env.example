# ==============================================================
# Template des variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# ==============================================================

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://db:5432/todolist
DB_USERNAME=
DB_PASSWORD=

# JWT — Utiliser une clé aléatoire longue (min. 256 bits)
JWT_SECRET=
JWT_EXPIRATION=3600000

# Serveur
SERVER_PORT=8080

# JPA (update en dev, validate en prod)
JPA_DDL_AUTO=validate
